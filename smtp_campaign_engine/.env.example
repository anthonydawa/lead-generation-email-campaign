SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-local-only-service-role-key

# Use the SMTP values shown by the provider for your sending mailbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=campaign@yourdomain.com
SMTP_PASSWORD=use-an-app-password
SENDER_EMAIL=campaign@yourdomain.com
SENDER_NAME=Your Name

# Optional read-only check immediately before each scheduled follow-up.
CHECK_REPLIES_BEFORE_SEND=false
# IMAP_HOST=imap.example.com
IMAP_PORT=993
# IMAP_USERNAME=campaign@yourdomain.com
# IMAP_PASSWORD=use-an-app-password
IMAP_INBOX_FOLDER=INBOX

MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=120
DAILY_SEND_LIMIT=100
WORKER_POLL_SECONDS=30
FAILED_SEND_RETRY_SECONDS=300
