SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-local-only-service-role-key

GMAIL_CREDENTIALS_FILE=./credentials.json
GMAIL_TOKEN_FILE=./token.json

MIN_DELAY_SECONDS=300
MAX_DELAY_SECONDS=600
DAILY_SEND_LIMIT=60
DAILY_NEW_RECIPIENT_LIMIT=20
FIRST_DAY_NEW_RECIPIENT_LIMIT=15
SEND_WINDOW_START_HOUR_UTC=14
SEND_WINDOW_END_HOUR_UTC=22
SEND_WEEKDAYS_ONLY=true
ENABLE_LEGACY_CSV_WORKER=true
